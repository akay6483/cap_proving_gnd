exec_prefix="/usr/local/bin"
libdir="/usr/local/lib"
includedir="/usr/local/include"

Name: ns3-visualizer
Description: 
URL: 
Version: 3.48
Requires:  ns3-internet ns3-wifi ns3-lr-wpan ns3-point-to-point
Requires.private: 
Cflags: -I"${includedir}"  -I/usr/include/eigen3 -I/usr/include/libxml2 -I/usr/include/python3.14 -I/usr/include
Libs: -L"${libdir}" -lns3.48-visualizer-optimized  -lns3.48-internet-optimized -lns3.48-wifi-optimized -lns3.48-lr-wpan-optimized -lns3.48-point-to-point-optimized /usr/lib/x86_64-linux-gnu/libpython3.14.so -lstdc++exp
Libs.private: -L"${libdir}" 
